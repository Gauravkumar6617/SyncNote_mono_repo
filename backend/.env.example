# Environment
NODE_ENV=development
PORT=5000
HOST=localhost

# Database Configuration
# Options: sqlite, postgresql, mysql, mongodb
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./prisma/dev.db

# PostgreSQL Example (uncomment to use)
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/syncnote_db

# MySQL Example (uncomment to use)
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://user:password@localhost:3306/syncnote_db

# API Configuration
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
